NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/vitalCHECK-health-check
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=7d

# Email configuration (Gmail)
# Note: HOST, PORT et FROM sont maintenant codés en dur dans le code
# Seuls USER et PASS sont nécessaires dans le .env
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-app-password

# EmailJS configuration (optionnel, pour contourner les blocages SMTP)
# Créer un compte sur https://www.emailjs.com/ (gratuit: 200 emails/mois)
# EMAILJS_SERVICE_ID=your-service-id
# EMAILJS_TEMPLATE_ID=your-template-id
# EMAILJS_PUBLIC_KEY=your-public-key
# EMAILJS_PRIVATE_KEY=your-private-key

# SendGrid configuration (optionnel, alternative à EmailJS)
# Créer un compte sur https://sendgrid.com/ (gratuit: 100 emails/jour)
# SENDGRID_API_KEY=your-sendgrid-api-key

# CORS configuration is now hardcoded in server/index.js

# Cloudinary configuration for image uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Newsletter configuration
FRONTEND_URL=https://www.checkmyenterprise.com
BACKEND_URL=https://ubb-enterprise-health-check.onrender.com/api
EMAIL_FROM=info@checkmyenterprise.com

# Paiement : paypal (par défaut) ou afribapay (Mobile Money)
PAYMENT_PROVIDER=paypal

# AfribaPay (Mobile Money) — valeurs dans le .env local / Render uniquement, jamais dans le code
# Sandbox : https://api-sandbox.afribapay.com — Production : URL fournie par AfribaPay
AFRIBAPAY_BASE_URL=
AFRIBAPAY_PUBLIC_KEY=
AFRIBAPAY_SECRET_KEY=
AFRIBAPAY_MERCHANT_KEY=
# URL publique HTTPS du webhook : https://<api>/api/payments/afribapay/webhook
AFRIBAPAY_NOTIFY_URL=
# Revérification des commandes PENDING même si PAYMENT_PROVIDER=paypal (true/false)
AFRIBAPAY_RECONCILER=false

# Rappels de renouvellement J-3 et expiration des périodes payées (true/false)
RENEWAL_REMINDERS_ENABLED=false
