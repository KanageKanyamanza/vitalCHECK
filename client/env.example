VITE_API_URL=https://vitalcheck-brtv.onrender.com/api

# Drapeaux de fonctionnalités (true pour activer)
VITE_F1_HIDDEN_LOSSES=false
VITE_F2_ALERT_CHECK=false
# Historique F2 sur l'appareil (avis juridique attendu) : coupé = rien n'est lu ni écrit
VITE_F2_LOCAL_HISTORY=false
# Bandeau « Valeurs provisoires » sur un build de production (préproduction uniquement)
VITE_SHOW_DRAFT_BANNER=false
